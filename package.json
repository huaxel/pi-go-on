{
  "name": "@juanbenjumea/pi-go-on",
  "version": "0.1.1",
  "description": "Goal-aware autonomous continuation for Pi conversations",
  "type": "module",
  "license": "MIT",
  "author": "Juan Benjumea",
  "keywords": [
    "pi-package",
    "pi-extension",
    "autonomy",
    "continuation",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huaxel/pi-go-on.git"
  },
  "bugs": {
    "url": "https://github.com/huaxel/pi-go-on/issues"
  },
  "homepage": "https://github.com/huaxel/pi-go-on#readme",
  "engines": {
    "node": ">=20.3.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.mjs",
    "prepublishOnly": "npm test && npm run typecheck",
    "typecheck": "tsc --noEmit --strict --allowImportingTsExtensions --moduleResolution bundler --module esnext --target esnext --skipLibCheck index.ts"
